# ============================================================================
# Document Intelligence — environment template. Copy to .env and fill in.
# ============================================================================

# --- App ---
DI_LOG_LEVEL=INFO
DI_EXECUTOR_WORKERS=32

# --- Postgres (local dev defaults match the Homebrew server) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=neelu
PG_PASSWORD=
PG_DATABASE=document_intelligence
PG_SCHEMA=di
PG_POOL_MIN=2
PG_POOL_MAX=16
PG_HASH_PARTITIONS=64
RLS_ENABLED=true

# --- Retrieval service (the model gateway: /api/embed, /api/llm/complete, /api/rerank) ---
RETRIEVAL_BASE_URL=http://localhost:8000
RETRIEVAL_API_KEY=
RETRIEVAL_TIMEOUT=120
# Run against an in-process fake (zero-vectors + echo) when the retrieval service is unavailable:
DI_RETRIEVAL_STUB=false

# --- Azure AI Vision Read (OCR). Empty -> degrade to local text-layer fallback. ---
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Gate / pipeline ---
GATE_DEFAULT_OPEN=true              # v1: most docs may reach the LLM (policy hooks still run)
CLASSIFIER_CONFIDENCE_FLOOR=0.55
MASKING_ENABLED_DEFAULT=false       # masking projections off by default; toggle per request

# --- Chunking / embeddings ---
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_DIM_DEFAULT=768           # fallback until /api/models reports the real dim
EMBEDDING_BATCH_SIZE=32
AREP_ASYNC=true                     # generate accessibility reps as an async backfill

# --- Object storage (optional, best-effort source persistence) ---
S3_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=document-intelligence
S3_ACCESS_KEY=
S3_SECRET_KEY=
