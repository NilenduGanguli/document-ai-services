# ============================================================================
# Document Intelligence — environment template. Copy to .env and fill in.
# The docker-compose stack sets these itself; this file is for bare-metal runs.
# ============================================================================

# --- App ---
DI_ENV=local                        # local | dev | staging | prod
DI_LOG_LEVEL=INFO
DI_EXECUTOR_WORKERS=32

# --- Postgres (local dev defaults match the Homebrew server) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=neelu
PG_PASSWORD=
PG_DATABASE=document_intelligence
PG_SCHEMA=di
PG_POOL_MIN=2
PG_POOL_MAX=16
PG_HASH_PARTITIONS=64               # IMMUTABLE after the first deploy — startup fails on a mismatch
RLS_ENABLED=true

# --- AuthN / AuthZ ---
AUTH_ENABLED=true                   # false leaves EVERY /api/v1 route open — local demos only
DI_BOOTSTRAP_API_KEY=               # seeds a wildcard key at startup so a fresh deploy is usable

# --- Retrieval service (the model gateway: /api/embed, /api/llm/complete, /api/rerank) ---
RETRIEVAL_BASE_URL=http://localhost:8000
RETRIEVAL_API_KEY=
RETRIEVAL_TIMEOUT=120
# Run against an in-process fake (deterministic vectors + echo) when the gateway is unavailable:
DI_RETRIEVAL_STUB=false

# --- Azure AI Vision Read (OCR). Empty -> degrade to local Tesseract. ---
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Blob storage: where the raw uploaded document bytes live ---
# postgres = bytea in di_blob | local = filesystem/docker volume | s3 = S3/MinIO | none = don't retain
BLOB_BACKEND=postgres
BLOB_LOCAL_DIR=/data/blobs
S3_ENDPOINT=                        # set for MinIO/S3-compatible; empty = real AWS
S3_BUCKET=document-intelligence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PREFIX=documents

# --- Gate / pipeline ---
GATE_DEFAULT_OPEN=true              # v1: most docs may reach the LLM (policy hooks still run)
CLASSIFIER_CONFIDENCE_FLOOR=0.55
MASK_BY_DEFAULT=true                # fail-closed: sensitive values redacted unless asked for
INGEST_CONCURRENCY=4                # max ingest jobs running at once per instance

# --- Request limits ---
MAX_UPLOAD_MB=25
MAX_TOP_K=100
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# --- Chunking / embeddings ---
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_DIM_DEFAULT=768           # fallback until /api/models reports the real dim
EMBEDDING_BATCH_SIZE=32
AREP_ASYNC=false                    # true defers accessibility reps to a backfill worker

# --- Ontology ---
ONTOLOGY_VERSION=1.0.0              # stamped onto facts so their vintage survives ontology changes
